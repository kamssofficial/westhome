{
  "name": "westhome",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "qa:static": "node scripts/qa-static-check.mjs",
    "qa:regression": "node scripts/qa-audit-regression.mjs",
    "qa:preflight": "node scripts/preflight-audit.mjs",
    "prewarm": "node scripts/prewarm-images.mjs",
    "audit:images": "node --env-file=.env scripts/audit-public-images.mjs",
    "deploy:check": "node scripts/godaddy-deploy-check.mjs",
    "migrate:images": "node --env-file=.env scripts/migrate-images-to-drive.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:proxy": "node --test tests/image-proxy.test.mjs",
    "test:audit": "node --test tests/audit-public-images.test.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-slot": "^1.3.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^13.1.0",
    "googleapis": "^178.0.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.33.0",
    "motion": "^13.1.1",
    "next": "16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.0",
    "razorpay": "^2.9.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hot-toast": "^2.6.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.19.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
