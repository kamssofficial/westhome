    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "mysql2": "3.24.4",
    "fast-uri": "3.1.8",
    "js-yaml": "4.3.2"
  }
