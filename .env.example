# Required
DATABASE_URL="postgresql://user:password@localhost:5432/westhome"
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Payments
RAZORPAY_KEY_ID="rzp_test_xxxxx"
RAZORPAY_KEY_SECRET="xxxxx"

# Media storage (Cloudflare R2) — required for production uploads;
# without these, uploads fall back to the local dev filesystem.
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="r2-api-token-access-key"
R2_SECRET_ACCESS_KEY="r2-api-token-secret"
R2_BUCKET="westhome-media"
R2_PUBLIC_BASE_URL="https://images.westhome.in"

# NOTE: Production media uploads require one complete storage backend to be configured in Vercel.

# Backblaze B2 (S3-compatible; preferred when configured)
B2_KEY_ID="your-backblaze-key-id"
B2_APPLICATION_KEY="your-backblaze-application-key"
B2_BUCKET="westhome-images"
B2_ENDPOINT="https://s3.us-east-005.backblazeb2.com"
B2_PUBLIC_BASE_URL="https://your-public-media-domain.example.com"

# GitHub repository storage (preferred for this deployment)
# Use a fine-grained token with Contents: Read and write on the repository.
GITHUB_STORAGE_TOKEN="github_pat_your_token"
GITHUB_STORAGE_REPO="salmansahil2005/westhome"
GITHUB_STORAGE_BRANCH="main"
GITHUB_STORAGE_PATH="public/images/uploads"
