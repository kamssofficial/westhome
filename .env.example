# Required
DATABASE_URL="postgresql://user:password@localhost:5432/westhome"
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Payments
RAZORPAY_KEY_ID="rzp_test_xxxxx"
RAZORPAY_KEY_SECRET="xxxxx"

# Media storage (Google Drive) — required for production uploads;
# without these, uploads fall back to the local dev filesystem.
# Preference 1: OAuth refresh token for a user-owned Drive account.
GOOGLE_OAUTH_CLIENT_ID="your-oauth-client-id.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="your-oauth-client-secret"
GOOGLE_OAUTH_REFRESH_TOKEN="your-oauth-refresh-token"
# Preference 2: service-account credentials file path or inline JSON.
GOOGLE_CREDENTIALS_PATH="/absolute/path/to/service-account.json"
# GOOGLE_CREDENTIALS_JSON='{"type":"service_account",...}'
# Optional: parent folder id to place media folders under in Drive.
# GOOGLE_DRIVE_ROOT_FOLDER_ID="your-drive-folder-id"