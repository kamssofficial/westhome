// WESTHOME by BM Distributors - Database Schema
// Complete ecommerce platform database architecture

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// AUTH & USERS
// ============================================================

enum UserRole {
  CUSTOMER
  ADMIN
  MANAGER
  ORDER_MANAGER
  PRODUCT_MANAGER
  CONTENT_MANAGER
  STAFF
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String
  phone         String?    @unique
  role          UserRole  @default(CUSTOMER)
  emailVerified DateTime?
  image         String?
  isActive      Boolean   @default(true)
  permissions   String    @default("[]")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  addresses      Address[]
  orders         Order[]
  reviews        Review[]
  wishlist       Wishlist[]
  recentlyViewed RecentlyViewed[]
  analyticsEvents AnalyticsEvent[]
  couponsUsed    CouponUsage[]

  @@index([email])
  @@index([role])
}

// ============================================================
// PRODUCTS
// ============================================================

model Product {
  id              String        @id @default(cuid())
  name            String
  slug            String        @unique
  sku             String?       @unique
  description     String?
  shortDescription String?
  status          ProductStatus @default(DRAFT)
  isActive        Boolean       @default(true)
  isFeatured      Boolean       @default(false)
  isBestseller    Boolean       @default(false)
  isNewArrival    Boolean       @default(false)
  isComingSoon    Boolean       @default(false)
  isLimitedEdition Boolean      @default(false)

  // Pricing
  regularPrice    Decimal
  salePrice       Decimal?
  costPrice       Decimal?
  promotionalPrice Decimal?

  // Inventory
  stockQuantity   Int           @default(0)
  lowStockThreshold Int         @default(5)
  allowBackorder  Boolean       @default(false)
  trackInventory  Boolean       @default(true)

  // Physical Dimensions
  height          Decimal?
  width           Decimal?
  length          Decimal?
  depth           Decimal?
  diameter        Decimal?
  dimensionUnit   String?       @default("cm")
  weight          Decimal?
  weightUnit      String?       @default("kg")
  capacity        Decimal?
  capacityUnit    String?       @default("L")

  // Physical Attributes
  material        String?
  color           String?
  finish          String?
  shape           String?
  pattern         String?
  style           String?
  mountingType    String?
  usageLocation   String?       // Indoor, Outdoor, Bathroom, etc.

  // Product Information
  careInstructions String?
  warranty         String?

  // Packaging
  packagingType       String?
  packagingDimensions String?
  packagingWeight     Decimal?
  includedItems       String?

  // Sizing
  allowCustomSize Boolean       @default(false)
  customSizeMinWidth  Decimal?
  customSizeMinLength Decimal?
  customSizeMinHeight Decimal?
  customSizeMaxWidth  Decimal?
  customSizeMaxLength Decimal?
  customSizeMaxHeight Decimal?
  customSizeUnit  String?       @default("cm")
  customSizePricingMethod String? @default("area") // area, linear, fixed
  customSizeRequiresApproval Boolean @default(false)

  // Purchase
  purchaseMethod  PurchaseMethod @default(BOTH) // BUY_ONLINE, WHATSAPP, BOTH
  whatsappMessage String?

  // Category
  categoryId      String
  subcategoryId   String?

  // SEO
  seoTitle        String?
  seoDescription  String?
  metaKeywords    String?
  canonicalUrl    String?

  // Timestamps
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  category        Category      @relation(fields: [categoryId], references: [id])
  subcategory     Subcategory?  @relation(fields: [subcategoryId], references: [id])
  images          ProductImage[]
  videos          ProductVideo[]
  variants        ProductVariant[]
  variantAttributes VariantAttribute[]
  tags            ProductTag[]
  reviews         Review[]
  orderItems      OrderItem[]
  wishlist        Wishlist[]
  recentlyViewed  RecentlyViewed[]
  analyticsEvents AnalyticsEvent[]
  couponProducts  CouponProduct[]
  promotionProducts PromotionProduct[]

  @@index([slug])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([status])
  @@index([isFeatured])
  @@index([isNewArrival])
  @@index([isBestseller])
  @@index([createdAt])
  @@index([regularPrice])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PurchaseMethod {
  BUY_ONLINE
  WHATSAPP
  BOTH
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  position  Int     @default(0)
  isPrimary Boolean @default(false)
  imageType String  @default("PRODUCT") // PRODUCT, LIFESTYLE

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([imageType])
}

model ProductVideo {
  id        String  @id @default(cuid())
  productId String
  url       String
  title     String?
  position  Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductTag {
  id        String  @id @default(cuid())
  productId String
  tag       String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, tag])
  @@index([productId])
  @@index([tag])
}

// ============================================================
// PRODUCT VARIANTS
// ============================================================

model ProductVariant {
  id          String  @id @default(cuid())
  productId   String
  sku         String? @unique
  name        String  // e.g. "Blue / Large" or "Small - 20x20x25cm"
  price       Decimal
  salePrice   Decimal?
  costPrice   Decimal?
  stockQuantity Int @default(0)
  weight      Decimal?
  isActive    Boolean @default(true)
  position    Int     @default(0)

  // Variant images
  images      VariantImage[]

  // Variant-specific attribute selections
  attributes  VariantAttributeValue[]

  // Order items using this variant
  orderItems  OrderItem[]

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sku])
}

model VariantImage {
  id              String  @id @default(cuid())
  variantId       String
  url             String
  alt             String?
  position        Int     @default(0)
  isPrimary       Boolean @default(false)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
}

// ============================================================
// VARIANT ATTRIBUTES (Flexible attribute system)
// ============================================================

model VariantAttribute {
  id          String  @id @default(cuid())
  productId   String
  name        String  // e.g. "Color", "Size", "Material"
  type        String  @default("TEXT") // TEXT, COLOR, DIMENSION
  position    Int     @default(0)

  product  Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values   VariantAttributeValue[]

  @@unique([productId, name])
  @@index([productId])
}

model VariantAttributeValue {
  id                   String  @id @default(cuid())
  variantAttributeId   String
  variantId            String
  value                String  // e.g. "Blue", "Large", "Cotton"
  colorCode            String? // For color attributes, e.g. "#FF0000"
  position             Int     @default(0)

  variantAttribute VariantAttribute @relation(fields: [variantAttributeId], references: [id], onDelete: Cascade)
  variant          ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantAttributeId, variantId])
  @@index([variantAttributeId])
  @@index([variantId])
}

// ============================================================
// CATEGORIES & SUBCATEGORIES
// ============================================================

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  image       String?
  isActive    Boolean @default(true)
  position    Int     @default(0)

  // SEO
  seoTitle       String?
  seoDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products     Product[]
  subcategories Subcategory[]
  images       CategoryImage[]
  promotionCategories PromotionCategory[]
  couponCategories CouponCategory[]

  @@index([slug])
  @@index([position])
}

model CategoryImage {
  id         String  @id @default(cuid())
  categoryId String
  url        String
  alt        String?
  position   Int     @default(0)
  isPrimary  Boolean @default(false)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

model Subcategory {
  id          String  @id @default(cuid())
  categoryId  String
  name        String
  slug        String  @unique
  description String?
  image       String?
  isActive    Boolean @default(true)
  position    Int     @default(0)

  // SEO
  seoTitle       String?
  seoDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products  Product[]

  @@index([categoryId])
  @@index([slug])
  @@index([position])
}

// ============================================================
// ORDERS
// ============================================================

enum OrderStatus {
  NEW
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
  PAYMENT_FAILED
  ON_HOLD
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  userId          String?
  status          OrderStatus @default(NEW)

  // Customer info (stored for guest checkout too)
  customerName    String
  customerEmail   String
  customerPhone   String

  // Shipping address
  addressLine1    String
  addressLine2    String?
  city            String
  state           String
  pinCode         String
  country         String      @default("India")

  // Pricing
  subtotal        Decimal
  discount        Decimal     @default(0)
  deliveryCharge  Decimal     @default(0)
  tax             Decimal     @default(0)
  total           Decimal

  // Payment
  paymentMethod   String?
  paymentId       String?
  paymentStatus   PaymentStatus @default(PENDING)
  paymentVerified Boolean     @default(false)

  // Delivery
  deliveryMethod  String      @default("delivery") // delivery, pickup
  estimatedDelivery DateTime?
  deliveredAt     DateTime?

  // Tracking
  trackingNumber  String?
  trackingUrl     String?
  shippingCarrier String?

  // Notes
  customerNotes   String?
  adminNotes      String?

  // Coupon
  couponId        String?
  couponCode      String?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  user    User?        @relation(fields: [userId], references: [id])
  items   OrderItem[]
  payment Payment?
  statusHistory OrderStatusHistory[]

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  productId     String
  variantId     String?
  productName   String
  variantName   String?
  sku           String?
  quantity      Int
  unitPrice     Decimal
  salePrice     Decimal?
  totalPrice    Decimal
  customSize    Json?   // Store custom size info
  image         String?

  order    Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product  Product        @relation(fields: [productId], references: [id])
  variant  ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String        @unique
  razorpayOrderId String?
  razorpayPaymentId String?
  razorpaySignature String?
  amount          Decimal
  currency        String        @default("INR")
  status          PaymentStatus @default(PENDING)
  method          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
}

// ============================================================
// ADDRESSES
// ============================================================

model Address {
  id          String  @id @default(cuid())
  userId      String
  name        String
  phone       String
  addressLine1 String
  addressLine2 String?
  city        String
  state       String
  pinCode     String
  country     String  @default("India")
  isDefault   Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================
// REVIEWS
// ============================================================

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

model Review {
  id         String       @id @default(cuid())
  userId     String
  productId  String
  rating     Int
  title      String?
  comment    String?
  image      String?
  status     ReviewStatus @default(PENDING)
  isFeatured Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@index([productId])
  @@index([rating])
  @@index([status])
}

// ============================================================
// WISHLIST & RECENTLY VIEWED
// ============================================================

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

model RecentlyViewed {
  id        String   @id @default(cuid())
  userId    String
  productId String
  viewedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

// ============================================================
// COUPONS
// ============================================================

enum CouponType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id                String     @id @default(cuid())
  code              String     @unique
  type              CouponType
  value             Decimal
  maxDiscountAmount Decimal?
  minOrderAmount    Decimal?
  usageLimit        Int?
  usedCount         Int        @default(0)
  perCustomerLimit  Int?
  isActive          Boolean    @default(true)
  startsAt          DateTime?
  expiresAt         DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  // Relations
  products   CouponProduct[]
  categories CouponCategory[]
  usages     CouponUsage[]

  @@index([code])
  @@index([isActive])
}

model CouponProduct {
  id        String @id @default(cuid())
  couponId  String
  productId String

  coupon  Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([couponId, productId])
}

model CouponCategory {
  id         String @id @default(cuid())
  couponId   String
  categoryId String

  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([couponId, categoryId])
}

model CouponUsage {
  id       String   @id @default(cuid())
  couponId String
  userId   String
  orderId  String
  usedAt   DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([couponId])
  @@index([userId])
}

// ============================================================
// PROMOTIONS
// ============================================================

model Promotion {
  id          String   @id @default(cuid())
  name        String
  description String?
  image       String?
  discountType String? // percentage, fixed
  discountValue Decimal?
  isActive    Boolean  @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  position    Int      @default(0)
  link        String?
  ctaText     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products   PromotionProduct[]
  categories PromotionCategory[]

  @@index([isActive])
}

model PromotionProduct {
  id          String @id @default(cuid())
  promotionId String
  productId   String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([promotionId, productId])
}

model PromotionCategory {
  id          String @id @default(cuid())
  promotionId String
  categoryId  String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([promotionId, categoryId])
}

// ============================================================
// HOMEPAGE SECTIONS
// ============================================================

enum SectionType {
  HERO
  CATEGORIES
  FEATURED_PRODUCTS
  NEW_ARRIVALS
  PROMOTIONAL_BANNER
  LIFESTYLE_COLLECTION
  BRAND_STORY
  STORE_INFO
  CUSTOM_HTML
}

model HomepageSection {
  id          String      @id @default(cuid())
  type        SectionType
  title       String?
  subtitle    String?
  description String?
  image       String?
  videoUrl    String?
  buttonText  String?
  buttonLink  String?
  buttonStyle String?     // primary, secondary, outline
  isActive    Boolean     @default(true)
  position    Int         @default(0)
  backgroundColor String?
  textColor   String?
  content     Json?       // Flexible content storage
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([position])
  @@index([type])
  @@index([isActive])
}

// ============================================================
// SITE SETTINGS
// ============================================================

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value Json
  group String @default("general") // general, contact, delivery, payment, seo, social

  @@index([key])
  @@index([group])
}

// ============================================================
// NAVIGATION
// ============================================================

enum NavigationType {
  HEADER
  FOOTER
  MOBILE
}

model NavigationItem {
  id          String       @id @default(cuid())
  type        NavigationType
  label       String
  url         String
  icon        String?
  isActive    Boolean      @default(true)
  position    Int          @default(0)
  openInNewTab Boolean     @default(false)
  parent      String?      // For nested items
  createdAt   DateTime     @default(now())

  @@index([type])
  @@index([position])
}

// ============================================================
// CONTENT PAGES
// ============================================================

model ContentPage {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  content      String
  metaTitle    String?
  metaDescription String?
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([slug])
}

// ============================================================
// ADMIN AUDIT LOG
// ============================================================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

// ============================================================
// NOTIFICATIONS
// ============================================================

enum NotificationType {
  ORDER_PLACED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  ORDER_CONFIRMED
  ORDER_SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
  NEW_CUSTOMER
  LOW_STOCK
  PRODUCT_UPDATED
  STAFF_UPDATED
  GENERAL
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  orderId   String?
  readBy    String           @default("[]") // JSON array of user IDs who have read this
  deletedBy String           @default("[]") // JSON array of user IDs who have deleted this
  channel   String           @default("internal") // email, whatsapp, sms, internal
  sentAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([type])
  @@index([createdAt])
}

// ============================================================
// ANALYTICS & TRACKING
// ============================================================

model AnalyticsEvent {
  id                String   @id @default(cuid())
  eventType         String   // VIEW, CLICK, ADD_TO_CART, BUY_NOW, WHATSAPP_ENQUIRY, PURCHASE, SEARCH, WISHLIST
  userId            String?  // null for guests
  sessionId         String?  // anonymous session identifier
  productId         String?
  categoryId        String?
  subcategoryId     String?
  metadata          Json?    // additional context (search query, etc.)
  userAgent         String?
  deviceType        String?  // mobile, desktop, tablet
  createdAt         DateTime @default(now())

  // Relations
  user    User?    @relation(fields: [userId], references: [id])
  product Product? @relation(fields: [productId], references: [id])

  @@index([eventType])
  @@index([createdAt])
  @@index([userId])
  @@index([productId])
  @@index([sessionId])
  @@index([eventType, createdAt])
}

model LiveSession {
  id          String   @id @default(cuid())
  sessionId   String   @unique
  userId      String?
  lastActive  DateTime @default(now())
  userAgent   String?
  deviceType  String?  // mobile, desktop, tablet
  isStaff     Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([lastActive])
  @@index([isStaff])
}
